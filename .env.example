# Envoi des demandes de devis (formulaire de contact) — via Resend.
# Copier ce fichier en .env.local et renseigner les valeurs.
# Sans RESEND_API_KEY ni CONTACT_TO_EMAIL, les demandes sont seulement
# journalisées (utile en développement).

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Adresse qui reçoit les demandes de devis
CONTACT_TO_EMAIL=

# Expéditeur affiché dans l'email.
# Tant que le nom de domaine n'est pas vérifié chez Resend, garder l'adresse
# de test ci-dessous (sinon l'envoi est refusé).
CONTACT_FROM_EMAIL="Demande de devis <onboarding@resend.dev>"

# URL publique du site (sitemap, robots.txt, Open Graph).
# À définir sur Vercel une fois le nom de domaine acheté, ex. :
# NEXT_PUBLIC_SITE_URL=https://www.antoine-plomberie.fr
NEXT_PUBLIC_SITE_URL=
